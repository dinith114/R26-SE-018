# Segmentation debug previews (regenerate with: python src/segmentation.py)
ml-models/hybrid_pollination/results/segmentation_check/

# ===========================
# Component 4 - Hybrid Pollination
# ===========================
# Embedding caches: regenerated by the training scripts, and useless to a
# clone anyway because data/images/ is not tracked. ~20 MB of dead weight.
ml-models/*/data/*_embeddings.npy
ml-models/*/data/*_embeddings.npz

# Spot-check previews for the auto-labelled flower set (regenerable)
ml-models/hybrid_pollination/results/flower_label_review/

# The DEPLOYED models are tracked despite the blanket *.pkl rule above.
# Without them the backend cannot start, and they cannot be rebuilt from a
# clone because the training photographs are not in the repository.
!ml-models/hybrid_pollination/models/best_model.pkl
!ml-models/hybrid_pollination/models/preprocessors.pkl
!ml-models/hybrid_pollination/models/trait_leaf_condition.pkl
!ml-models/hybrid_pollination/models/trait_plant_strength.pkl
!ml-models/hybrid_pollination/models/orchid_gate.pkl
!ml-models/hybrid_pollination/models/flower_filter.pkl

